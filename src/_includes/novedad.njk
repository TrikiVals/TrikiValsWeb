---
layout: base.njk
---
<article class="bloque estrecho">
  <p class="etiqueta">{{ seccion or "Novedad" }} · {{ page.date | fecha }}</p>
  <h1>{{ title }}</h1>
  {% if imagen %}<img class="portada" src="{{ imagen }}" alt="">{% endif %}
  {% if resumen %}<p class="entrada">{{ resumen }}</p>{% endif %}
  <div class="texto">{{ content | safe }}</div>
  {% if enlace %}<p><a class="boton" href="{{ enlace }}">{{ enlace_texto or "Más información" }}</a></p>{% endif %}
  <p><a href="/novedades/">Todas las novedades</a></p>
</article>
